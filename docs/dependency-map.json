    "demoshop.payments",
    "demoshop.gateway"
  ],
  "config_files": [
    {
      "path": "config/payment.json",
      "loaded_by": "demoshop.config.load_payment_config",
      "affects": ["demoshop.payments", "demoshop.checkout"]
    }
  ]
}
